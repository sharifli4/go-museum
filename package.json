{
  "name": "go-museum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run generate:go-sources && next dev",
    "build": "npm run generate:go-sources && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate:escape": "node scripts/generate-escape-source.mjs",
    "generate:parser": "node scripts/generate-parser-source.mjs",
    "generate:slices": "node scripts/generate-slices-source.mjs",
    "generate:go-sources": "npm run generate:escape && npm run generate:parser && npm run generate:slices",
    "check:escape": "node scripts/check-escape.mjs",
    "check:parser": "node scripts/check-parser.mjs",
    "check:slices": "node scripts/check-slices.mjs",
    "check:go": "npm run check:escape && npm run check:parser && npm run check:slices",
    "check:overflow": "node scripts/check-overflow.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "typescript": "^5"
  }
}
